# ============================================
# Ultimate Telegram AI Bot — Environment template
# ============================================
# For local use, copy this to .env.local and fill in your real keys
# (the bot loads .env.local first, overriding any values here).
# You can also paste keys directly into this file if you don't plan to push.

# --- Telegram ---
TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# --- OpenAI ---
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL_ID=gpt-4o-mini

# --- Bot behavior ---
REPLY_TO_MENTIONS_ONLY=true
STREAMING=true
HISTORY_RUNS=8
SHOW_STATUS_LINES=true
QUOTED_REPLIES=true
EMOJI_REACTION=👀
# Allow the bot to converse with OTHER AI bots (@mentions/replies only)
RESPOND_TO_OTHER_BOTS=true
# Anti-loop cap for consecutive bot-to-bot replies
BOT_LOOP_MAX_DEPTH=3
